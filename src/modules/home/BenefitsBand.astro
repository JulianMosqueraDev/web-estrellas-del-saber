---
import { Image } from "astro:assets";
import FeatureIcon from "../../components/atoms/FeatureIcon.astro";
import type { FeatureIconName } from "../../components/atoms/feature-icon.types";
import { bumps, sparklePath } from "../../utils/cloud-path";

import arcoiris from "../../components/shared/icons/arcoiris.png";
import estrella from "../../components/shared/icons/estrella.png";

type Beneficio = { icono: FeatureIconName | "rainbow"; titulo: string; texto: string };

const beneficios: Beneficio[] = [
  { icono: "heart", titulo: "Ambientes seguros", texto: "donde cada niño se siente en casa." },
  { icono: "family", titulo: "Familias que confían", texto: "Construimos juntos su mejor historia." },
  { icono: "leaf", titulo: "Equipo comprometido", texto: "Educadores que inspiran." },
  { icono: "rainbow", titulo: "Un futuro brillante", texto: "Valores para la vida." },
];

/* Ola superior (viewBox 1536 × 140): alta a la izquierda, baja al centro y sube a la derecha,
   detrás de la foto. La capa trasera, más clara, asoma por encima. */
const waveBack =
  "M0 30 C140 18 250 58 420 74 S760 96 940 88 S1230 66 1350 34 S1500 -6 1536 -10 L1536 141 L0 141 Z";
const waveFront =
  "M0 52 C130 54 240 88 400 98 S730 118 910 108 S1190 92 1300 64 S1470 14 1536 6 L1536 141 L0 141 Z";

// Nubes del borde inferior (viewBox 1536 × 90): grandes en las esquinas, bajas al centro
const bottomClouds =
  "M0 92 L0 38" +
  bumps(0, 38, [
    [80, 28, 26], [170, 40, 22], [260, 56, 14], [380, 68, 10], [520, 74, 8], [680, 76, 6],
    [840, 76, 6], [1000, 74, 8], [1120, 64, 12], [1220, 50, 18], [1310, 40, 24], [1400, 32, 26],
    [1470, 36, 22], [1536, 42, 16],
  ]) +
  " L1536 92 Z";

// Destellos sobre la franja (en % de la franja)
const sparkles: [number, number, number][] = [
  [2.5, 22, 6], [9, 70, 4], [19, 18, 5], [31, 66, 4], [44, 20, 6], [57, 72, 4],
  [63, 16, 5], [76, 60, 4], [84, 14, 6], [97, 30, 5], [50, 48, 3], [88, 52, 3],
];
---

<section class="benefits" aria-label="Por qué elegirnos">
  <svg class="benefits__wave" viewBox="0 0 1536 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d={waveBack} fill="#8fa8e8" fill-opacity=".6" />
    <path d={waveFront} fill="#24439a" />
  </svg>

  <div class="benefits__band">
    <div class="benefits__sparkles" aria-hidden="true">
      {sparkles.map(([x, y, s]) => (
        <svg class="spark" viewBox="-10 -10 20 20" style={`left:${x}%;top:${y}%;width:${s * 2}px`}>
          <path d={sparklePath(0, 0, 10)} fill="#fff" />
        </svg>
      ))}
    </div>

    <div class="benefits__inner">
      <ul class="benefits__list">
        {beneficios.map((b) => (
          <li class="benefit">
            <span class="benefit__icon" aria-hidden="true">
              {b.icono === "rainbow" ? (
                <Image src={arcoiris} alt="" width={140} format="webp" quality={80} />
              ) : (
                <FeatureIcon name={b.icono} size={52} idPrefix={`benefit-${b.icono}`} />
              )}
            </span>
            <span class="benefit__text">
              <strong>{b.titulo}</strong>
              <span>{b.texto}</span>
            </span>
          </li>
        ))}
      </ul>

      <!-- Estrellita y planeta Tierra (decoración) -->
      <div class="benefits__mascot" aria-hidden="true">
        <svg class="benefits__trail" viewBox="0 0 200 80">
          <path d="M4 6c30 2 52 18 78 34s58 26 92 22" />
        </svg>
        <Image src={estrella} alt="" width={240} format="webp" quality={80} class="benefits__star" />
        <span class="benefits__globe"><FeatureIcon name="globe" size={96} idPrefix="benefits-globe" /></span>
      </div>
    </div>

    <svg class="benefits__clouds" viewBox="0 0 1536 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="benefits-clouds" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="1" stop-color="#f7f9ff" />
        </linearGradient>
      </defs>
      <path d={bottomClouds} fill="url(#benefits-clouds)" />
    </svg>
  </div>
</section>

<style>
  .benefits {
    --wave-h: clamp(4.5rem, 9vw, 8.5rem);
    position: relative;
    z-index: 1;
    /* La ola sube por detrás de la parte baja de las cards de pilares y de la foto */
    margin-top: calc(-0.74 * var(--wave-h));
  }

  .benefits__wave {
    display: block;
    width: 100%;
    height: var(--wave-h);
    margin-bottom: -1px;
  }

  .benefits__band {
    position: relative;
    padding-bottom: clamp(2.6rem, 4.6vw, 4.6rem);
    color: #fff;
    background: linear-gradient(180deg, #24439a 0%, #1b3683 55%, #152b6c 100%);
  }

  .benefits__sparkles { position: absolute; inset: 0 0 2rem; pointer-events: none; }
  .spark {
    position: absolute;
    height: auto;
    opacity: .85;
    transform: translate(-50%, -50%);
    animation: twinkle 3.4s ease-in-out infinite;
  }
  .spark:nth-of-type(2n) { animation-delay: -1.2s; }
  .spark:nth-of-type(3n) { animation-delay: -2.3s; }
  @keyframes twinkle {
    0%, 100% { opacity: .9; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: .4; transform: translate(-50%, -50%) scale(.75); }
  }

  .benefits__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(11rem, 14vw, 12.6rem);
    align-items: center;
    gap: 1.5rem;
    width: min(100% - 2rem, 84rem);
    margin: 0 auto;
    padding-top: .3rem;
  }

  .benefits__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-content: space-between;
    gap: 1.2rem 1.5rem;
    margin: 0;
    padding: 0 0 0 clamp(0rem, 1.5vw, 1.5rem);
    list-style: none;
  }
  /* Escritorio ancho: cada descripción en un solo renglón, como en el mock */
  @media (min-width: 1200px) {
    .benefits__list { grid-template-columns: repeat(4, auto); }
    .benefit__text span { white-space: nowrap; }
  }
  .benefit {
    display: flex;
    align-items: center;
    gap: .8rem;
  }
  .benefit__icon {
    display: grid;
    flex: none;
    width: 3.3rem;
    height: 3.3rem;
    place-items: center;
  }
  .benefit__icon :global(svg),
  .benefit__icon :global(img) { width: 100%; height: auto; }
  .benefit__icon :global(img) { width: 118%; max-width: none; }
  .benefit__text { display: grid; gap: .15rem; }
  .benefit__text strong {
    font-family: "Baloo 2", "Nunito", sans-serif;
    /* Topes = tamaño a 1440 px: el contenedor no crece más, el texto tampoco */
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    font-weight: 700;
    line-height: 1.1;
  }
  .benefit__text span {
    color: #dfe7ff;
    font-size: clamp(.8rem, .92vw, .83rem);
    font-weight: 600;
    line-height: 1.3;
  }

  /* Estrellita + Tierra, apoyadas sobre las nubes del borde inferior */
  .benefits__mascot { position: relative; align-self: stretch; min-height: 4rem; }
  .benefits__trail {
    position: absolute;
    right: 62%;
    bottom: 52%;
    width: 9rem;
    fill: none;
    stroke: #fff;
    stroke-dasharray: 8 7;
    stroke-linecap: round;
    stroke-opacity: .85;
    stroke-width: 2.4;
  }
  .benefits__star {
    position: absolute;
    right: 34%;
    bottom: -2.6rem;
    z-index: 2;
    width: clamp(5rem, 7vw, 7rem);
    height: auto;
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 25%));
    animation: bob 4.5s ease-in-out infinite;
  }
  .benefits__globe {
    position: absolute;
    right: 0;
    bottom: -1rem;
    z-index: 1;
    width: clamp(4rem, 6vw, 6rem);
  }
  .benefits__globe :global(svg) { display: block; width: 100%; height: auto; }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(-6px) rotate(-4deg); }
  }

  .benefits__clouds {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: clamp(2.6rem, 4.6vw, 4.6rem);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1199px) {
    .benefits__list { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-left: 0; }
    .benefits__trail { display: none; }
  }
  @media (max-width: 767px) {
    .benefits__inner { grid-template-columns: minmax(0, 1fr); }
    .benefits__mascot { min-height: 5.5rem; }
    .benefits__star { right: 50%; bottom: -2rem; width: 5rem; transform-origin: center; }
    .benefits__globe { right: calc(50% - 6rem); bottom: -.6rem; width: 4rem; }
  }
  @media (max-width: 560px) {
    .benefits__list { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  }

  /* Escritorio: medidas en unidades del mock (--hu) para que el hero quepa en una pantalla */
  @media (min-width: 1200px) {
    .benefits {
      --wave-h: calc(110 * var(--hu));
      margin-top: calc(-0.8 * var(--wave-h));
    }
    .benefits__band { padding-bottom: calc(50 * var(--hu)); }
    .benefits__inner {
      grid-template-columns: minmax(0, 1fr) calc(190 * var(--hu));
      gap: calc(20 * var(--hu));
      width: calc(1412 * var(--hu));
      max-width: 100%;
      padding-top: calc(2 * var(--hu));
    }
    .benefits__list { gap: calc(18 * var(--hu)) calc(22 * var(--hu)); padding-left: calc(22 * var(--hu)); }
    .benefit { gap: calc(12 * var(--hu)); }
    .benefit__icon { width: calc(48 * var(--hu)); height: calc(48 * var(--hu)); }
    .benefit__text { gap: calc(2 * var(--hu)); }
    .benefit__text strong { font-size: calc(17.5 * var(--hu)); }
    .benefit__text span { font-size: calc(13.5 * var(--hu)); }

    .benefits__mascot { min-height: calc(50 * var(--hu)); }
    .benefits__trail { width: calc(135 * var(--hu)); }
    .benefits__star { bottom: calc(-40 * var(--hu)); width: calc(100 * var(--hu)); }
    .benefits__globe { bottom: calc(-14 * var(--hu)); width: calc(86 * var(--hu)); }
    .benefits__clouds { height: calc(52 * var(--hu)); }
  }
</style>
