---
import { Image } from "astro:assets";
import Icon from "../../components/atoms/Icon.astro";
import LevelCards from "./LevelCards.astro";
import PillarsSection from "./PillarsSection.astro";
import BenefitsBand from "./BenefitsBand.astro";
import { bumps, sparklePath } from "../../utils/cloud-path";

import fondoHero from "../../components/shared/icons/fondo-hero.png";
import mascota from "../../components/shared/icons/Estrellitas explorando el futuro.png";
// Copia de «Donde Cada Estrella Brilla.png» sin el párrafo: el párrafo va como texto HTML
import titulo from "../../components/shared/icons/titulo-hero.png";
import ninos from "../../components/shared/icons/Pequeños pasos, grandes historias.png";

/* =====================================================================
   HERO · dos fases (según mocks/hero/hero.png)
   Fase 1 «cielo»: fondo-hero.png (cielo, nubes laterales, arbustos y
     arcoíris) que continúa detrás del navbar. Encima: estrellita a la
     izquierda, título en nube al centro, niños a la derecha y botones.
     Un banco de nubes blancas integra la base de los personajes y
     conecta con la fase 2.
   Fase 2 «suelo»: niveles, pilares con foto y franja azul marino de
     beneficios. Su alto lo da el contenido (sin alturas fijas).
   ===================================================================== */

type Deco = { x: number; y: number; s: number; kind: "spark" | "white"; desk?: boolean };

// Fase 1 — destellos animados sobre el fondo (en % de la caja del cielo, que incluye el navbar)
const skySparkles: Deco[] = [
  { x: 2.5, y: 44, s: 9, kind: "spark" },
  { x: 28.5, y: 41, s: 6, kind: "white", desk: true },
  { x: 29, y: 66, s: 8, kind: "spark", desk: true },
  { x: 49, y: 37, s: 5, kind: "white", desk: true },
  { x: 70.5, y: 40, s: 7, kind: "spark", desk: true },
  { x: 70, y: 70, s: 6, kind: "white", desk: true },
  { x: 97.5, y: 42, s: 8, kind: "white" },
];

/* ---------- Siluetas ---------- */

// Nubes que cierran la fase 1 (viewBox 1536 × 160; los trazos bajan a 220 para no dejar costura).
// Lomas de distintos tamaños: altas a los lados (junto a los personajes) y bajas al centro (bajo los botones).
// Capa trasera: detrás de los personajes
const bankBack =
  "M0 220 L0 96" +
  bumps(0, 96, [
    [60, 92, 30], [150, 88, 34], [250, 98, 28], [340, 104, 30], [450, 112, 22], [540, 108, 24],
    [640, 114, 20], [740, 110, 22], [840, 114, 20], [940, 108, 24], [1040, 112, 22], [1140, 102, 28],
    [1240, 96, 32], [1330, 90, 34], [1430, 94, 30], [1536, 90, 28],
  ]) +
  " L1536 220 Z";
// Capa delantera: abraza la base de los personajes sin taparlos.
// Termina justo en el borde de la fase 2 (y = 160) para que su sombra no marque una línea.
const bankFront =
  "M0 161 L0 128" +
  bumps(0, 128, [
    [50, 126, 20], [130, 122, 24], [230, 130, 18], [310, 132, 20], [420, 146, 12], [520, 154, 8],
    [620, 156, 7], [720, 154, 8], [820, 156, 7], [920, 154, 8], [1020, 156, 7], [1110, 148, 10],
    [1190, 136, 16], [1270, 126, 24], [1360, 128, 20], [1450, 122, 24], [1536, 126, 18],
  ]) +
  " L1536 161 Z";
---

<section class="hero" aria-labelledby="hero-title">
  <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="hero-bank-back" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#eef0ff" />
        <stop offset=".5" stop-color="#ffffff" />
      </linearGradient>
      <filter id="hero-soft-glow" x="-10%" y="-40%" width="120%" height="180%">
        <feDropShadow dx="0" dy="-3" stdDeviation="7" flood-color="#5d8fe0" flood-opacity=".26" />
      </filter>
      <!-- Igual, pero la región del filtro termina en el borde inferior: sin sombra hacia abajo -->
      <filter id="hero-cloud-shadow" x="-10%" y="-80%" width="120%" height="180%">
        <feDropShadow dx="0" dy="-3" stdDeviation="7" flood-color="#5d8fe0" flood-opacity=".26" />
      </filter>
    </defs>
  </svg>

  <!-- ================= FASE 1 · Cielo ================= -->
  <div class="hero__sky">
    <div class="hero__sky-bg" aria-hidden="true">
      <Image
        src={fondoHero}
        alt=""
        widths={[800, 1280, 1900]}
        sizes="100vw"
        format="webp"
        quality={80}
        loading="eager"
        class="hero__bg-img"
      />

      {skySparkles.map((d) => (
        <svg class:list={["deco", "twinkle", { "deco--desk": d.desk }]} viewBox="-10 -10 20 20" style={`left:${d.x}%;top:${d.y}%;width:${d.s * 2}px`}>
          <path d={sparklePath(0, 0, 10)} fill={d.kind === "white" ? "#fff" : "#ffd23f"} />
        </svg>
      ))}

      <!-- Nubes traseras: cubren el borde del fondo y pasan a blanco -->
      <svg class="bank" viewBox="0 0 1536 160" preserveAspectRatio="none">
        <path d={bankBack} fill="url(#hero-bank-back)" filter="url(#hero-soft-glow)" />
      </svg>
    </div>

    <div class="hero__content hero__content--sky">
      <!-- Centro: título en nube + párrafo + botones -->
      <div class="hero__main">
        <div class="hero__title">
          <h1 id="hero-title" class="sr-only">Donde cada estrella brilla a su manera</h1>
          <Image
            src={titulo}
            alt=""
            widths={[480, 720, 960, 1240, 1400]}
            sizes="(max-width: 767px) 100vw, 43rem"
            format="webp"
            quality={86}
            loading="eager"
            fetchpriority="high"
            class="hero__title-img"
          />
          <!-- Mismos cortes de línea que la ilustración original (en móvil fluye libre) -->
          <p class="hero__lead">
            <span>Acompañamos a nuestros niños en un universo{" "}</span>
            <span>de aprendizaje, juego, creatividad y valores{" "}</span>
            <span>para un futuro lleno de posibilidades.</span>
          </p>
        </div>

        <div class="hero__actions">
          <a class="hero-btn hero-btn--primary" href="/nosotros">
            <span>Conócenos</span>
            <Icon name="arrow-right" size={24} />
          </a>
          <!-- Pendiente: enlazar el video real (página, YouTube o ventana modal) -->
          <a class="hero-btn hero-btn--video" href="/nosotros#video">
            <span class="hero-btn__play"><Icon name="play" size={21} /></span>
            <span>Ver nuestro video</span>
          </a>
        </div>
      </div>

      <!-- Lado izquierdo: estrellita exploradora con el letrero del lema -->
      <figure class="hero__art hero__mascot">
        <Image
          src={mascota}
          alt="Estrellita exploradora con mochila y lupa junto a un letrero de madera que dice: Jugando y Explorando mi Futuro voy Creando"
          widths={[320, 480, 640, 820]}
          sizes="(max-width: 767px) 42vw, (max-width: 1199px) 20rem, 26vw"
          format="webp"
          quality={82}
          loading="eager"
          class="hero__art-img"
        />
      </figure>

      <!-- Lado derecho: niños sobre el libro, cohete y nube «Pequeños pasos, grandes historias» -->
      <figure class="hero__art hero__kids">
        <Image
          src={ninos}
          alt="Tres niños felices sentados sobre un libro abierto, con un cohete, un arcoíris y una nube que dice: Pequeños pasos, grandes historias"
          widths={[400, 600, 800, 1000]}
          sizes="(max-width: 767px) 56vw, (max-width: 1199px) 28rem, 34vw"
          format="webp"
          quality={82}
          loading="eager"
          class="hero__art-img"
        />
      </figure>
    </div>

    <!-- Nubes delanteras: abrazan la base de los personajes -->
    <svg class="bank bank--front" viewBox="0 0 1536 160" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d={bankFront} fill="#fff" filter="url(#hero-cloud-shadow)" />
    </svg>
  </div>

  <!-- ================= FASE 2 · Suelo ================= -->
  <div class="hero__ground">
    <div class="hero__ground-bg" aria-hidden="true"></div>

    <div class="hero__content hero__content--ground">
      <LevelCards />
      <PillarsSection />
    </div>

    <BenefitsBand />
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0;
    isolation: isolate;
    overflow-x: clip;
  }

  .defs { position: absolute; }

  /* ================= Fase 1 ================= */
  .hero__sky { position: relative; }

  /* El cielo sube por detrás del navbar hasta el borde superior de la página */
  .hero__sky-bg {
    position: absolute;
    z-index: -1;
    top: calc(-1 * var(--nav-h));
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
    pointer-events: none;
    background: #3fb0f3;
  }
  .hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  .deco {
    position: absolute;
    height: auto;
    object-fit: contain;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 2px 3px rgb(200 130 0 / 22%));
  }
  .twinkle { animation: twinkle 3.2s ease-in-out infinite; }
  .twinkle:nth-of-type(3n) { animation-delay: -1.1s; }
  .twinkle:nth-of-type(3n + 1) { animation-delay: -2.2s; }
  @keyframes twinkle {
    0%, 100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: .55; transform: translate(-50%, -50%) scale(.8); }
  }

  /* Bancos de nubes del pie de la fase 1 */
  /* El SVG se estira (preserveAspectRatio="none"): el alto lo fija el CSS para que las
     nubes no crezcan de más en pantallas anchas; el ancho mínimo evita lomas aplastadas */
  .bank {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: max(100%, 43rem);
    height: max(4.5rem, 10.4vw);
    overflow: visible;
    pointer-events: none;
    transform: translateX(-50%);
  }
  .bank--front { z-index: 2; }

  /* ================= Fase 2 ================= */
  /* Sin alto fijo: lo dan los niveles, los pilares y la franja de beneficios */
  .hero__ground { position: relative; }
  .hero__ground-bg {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      linear-gradient(180deg, #ffffff 0, rgb(255 255 255 / 0%) 5rem),
      radial-gradient(ellipse 35% 40% at 85% 30%, rgb(236 226 255 / 55%), transparent 70%),
      radial-gradient(ellipse 35% 40% at 10% 40%, rgb(255 246 214 / 50%), transparent 70%),
      linear-gradient(180deg, #ffffff 0%, #f6faff 100%);
  }

  /* ================= Contenido ================= */
  .hero__content {
    position: relative;
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
  }

  /* Fase 2: la franja de niveles sube un poco y se monta sobre las nubes del pie de la fase 1 */
  .hero__content--ground {
    width: min(100% - 2rem, 84rem);
    margin-top: calc(-1 * clamp(1rem, 1.6vw, 1.75rem));
  }

  /* Fase 1 (compacta, como la referencia): estrellita a la izquierda · título al centro ·
     niños a la derecha. Los tres grupos arrancan justo debajo del navbar. */
  .hero__content--sky {
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(43rem, 52%) minmax(0, 1fr);
    grid-template-areas: "mascot main kids";
    align-items: start;
    width: min(100% - 2rem, 92rem);
    /* El aire bajo los botones crece con el ancho, igual que las nubes del pie,
       para que las nubes nunca se monten sobre los botones */
    padding-block: .25rem clamp(1.5rem, 2.6vw, 3.5rem);
  }
  .hero__main {
    grid-area: main;
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  /* Título en nube. El contenedor mide lo mismo que la imagen; los márgenes
     negativos compensan su aire transparente (3,4 % arriba y 5,7 % abajo del ancho). */
  .hero__title {
    --hw: 100%;
    position: relative;
    width: var(--hw);
    margin: calc(var(--hw) * -0.034) 0 calc(var(--hw) * -0.057);
    container-type: inline-size;
  }
  .hero__title-img {
    display: block;
    width: 100%;
    height: auto;
    filter:
      drop-shadow(0 0 .9rem rgb(255 255 255 / 75%))
      drop-shadow(0 .7rem 1.3rem rgb(30 90 180 / 24%));
  }

  /* Párrafo dentro de la parte baja de la nube (misma zona que en la ilustración original) */
  .hero__lead {
    position: absolute;
    top: 68.6%;
    left: 50%;
    display: grid;
    width: 66%;
    height: 17.4%;
    margin: 0;
    align-content: center;
    justify-items: center;
    color: #12275b;
    font-family: "Baloo 2", "Nunito", sans-serif;
    font-size: max(15px, 2.9cqw);
    font-weight: 600;
    line-height: 1.16;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  /* Ilustraciones laterales: se apoyan sobre las nubes del pie */
  .hero__art {
    align-self: end;
    margin: 0 0 -1.5rem;
  }
  /* Hover (estrellita y niños): contorno amarillo que sigue la silueta de la
     ilustración. Las sombras sin desenfoque encadenadas (→ ← ↓ ↑) dibujan el trazo
     sobre la transparencia del PNG; en reposo son transparentes para poder animarlas. */
  .hero__art-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter:
      drop-shadow(0 0 0 rgb(255 210 50 / 0%))
      drop-shadow(0 0 0 rgb(255 210 50 / 0%))
      drop-shadow(0 0 0 rgb(255 210 50 / 0%))
      drop-shadow(0 0 0 rgb(255 210 50 / 0%))
      drop-shadow(0 0 0 rgb(255 200 40 / 0%))
      drop-shadow(0 .8rem 1.1rem rgb(30 80 160 / 22%));
    transition: filter .3s ease;
  }
  @media (hover: hover) {
    .hero__art:hover .hero__art-img {
      filter:
        drop-shadow(4px 0 0 #ffd232)
        drop-shadow(-4px 0 0 #ffd232)
        drop-shadow(0 4px 0 #ffd232)
        drop-shadow(0 -4px 0 #ffd232)
        drop-shadow(0 0 14px rgb(255 200 40 / 75%))
        drop-shadow(0 .8rem 1.1rem rgb(30 80 160 / 22%));
    }
  }
  /* La estrellita asoma apenas por detrás del borde de la nube del título */
  .hero__mascot {
    grid-area: mascot;
    justify-self: start;
    width: min(100% + 2rem, 25rem);
    margin-left: -.5rem;
  }  /* Los niños se abren hacia el borde derecho y su arcoíris pasa por detrás
     de la nube del título, como en la referencia */
  .hero__kids {
    grid-area: kids;
    z-index: 0;
    justify-self: end;
    width: 128%;
    margin-right: -1.5rem;
  }

  /* Botones bajo el párrafo, montados sobre el borde inferior de la nube */
  .hero__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .9rem 1.75rem;
    margin-top: -1rem;
    font-family: "Baloo 2", "Nunito", sans-serif;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .6rem;
    min-height: 3.5rem;
    padding: .35rem 2rem;
    border-radius: 999px;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .hero-btn :global(svg) { flex: none; transition: transform .2s ease; }
  .hero-btn:hover { transform: translateY(-3px); }

  /* Conócenos: rosa relleno; la flecha avanza al pasar el mouse */
  .hero-btn--primary {
    border: 3px solid #fff;
    color: #fff;
    text-shadow: 0 1px 0 rgb(150 20 75 / 35%);
    background: linear-gradient(180deg, #ff6aa6 0%, #ec3b84 50%, #db2170 100%);
    box-shadow:
      0 6px 14px rgb(229 42 118 / 32%),
      inset 0 -3px 0 rgb(160 20 80 / 22%),
      inset 0 2px 0 rgb(255 255 255 / 28%);
  }
  .hero-btn--primary:hover { box-shadow: 0 10px 20px rgb(229 42 118 / 36%), inset 0 -3px 0 rgb(160 20 80 / 22%), inset 0 2px 0 rgb(255 255 255 / 28%); }
  .hero-btn--primary:hover :global(svg) { transform: translateX(4px); }

  /* Ver nuestro video: blanco con borde rosa y botón de reproducir */
  .hero-btn--video {
    padding-left: .4rem;
    border: 2.5px solid #f2468c;
    color: #12275b;
    background: #fff;
    box-shadow: 0 6px 14px rgb(30 80 150 / 18%);
  }
  .hero-btn--video:hover { box-shadow: 0 10px 20px rgb(30 80 150 / 24%); }
  .hero-btn__play {
    display: grid;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(180deg, #ff6aa6, #db2170);
    box-shadow: 0 3px 6px rgb(229 42 118 / 30%);
    transition: transform .2s ease;
  }
  .hero-btn__play :global(svg) { margin-left: 2px; }
  .hero-btn--video:hover .hero-btn__play { transform: scale(1.1); }

  /* Tablet: título y botones arriba; estrellita y niños comparten la fila de abajo */
  @media (max-width: 1199px) {
    .hero__content--sky {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      grid-template-areas: "main main" "mascot kids";
      column-gap: 1rem;
      row-gap: .75rem;
      padding-bottom: 2rem;
    }
    .hero__title { --hw: min(100%, 43rem); }
    .hero__art { margin-bottom: -.75rem; }
    .hero__mascot { justify-self: end; width: min(100%, 20rem); margin-left: 0; }
    .hero__kids { justify-self: start; width: min(100%, 28rem); margin-right: 0; }
  }

  /* Móvil */
  @media (max-width: 767px) {
    .deco--desk { display: none; }

    .hero__content--sky { column-gap: .25rem; padding-bottom: 2rem; }

    /* La nube ocupa todo el ancho; el párrafo pasa debajo a tamaño legible */
    .hero__title { --hw: min(100% + 1.5rem, 34rem); margin-bottom: 0; }
    .hero__lead {
      position: static;
      display: block;
      width: auto;
      height: auto;
      margin: calc(-5.7cqw + .6rem) 1rem 0;
      font-size: 1.3rem;
      line-height: 1.28;
      white-space: normal;
      text-wrap: balance;
      transform: none;
    }
    .hero__actions { gap: .8rem 1.25rem; margin-top: 1rem; }
    .hero-btn { min-height: 3.35rem; padding-inline: 1.5rem; font-size: 1.28rem; }
    .hero-btn--video { padding-left: .35rem; }
    .hero-btn__play { width: 2.45rem; height: 2.45rem; }
    .hero__art { margin-bottom: -.6rem; }
  }

  /* Teléfonos: los botones se apilan, anchos y fáciles de tocar */
  @media (max-width: 480px) {
    .hero__actions { flex-direction: column; align-items: center; gap: .85rem; }
    /* Botones anchos: texto centrado y el ícono en la esquina */
    .hero-btn { position: relative; width: min(19rem, 100%); padding-inline: 3.2rem; }
    .hero-btn--primary :global(svg) { position: absolute; top: 0; right: 1.1rem; bottom: 0; margin-block: auto; }
    .hero-btn__play { position: absolute; top: 0; bottom: 0; left: .35rem; margin-block: auto; }
  }

  /* ================= Escritorio: todo el hero en la primera pantalla =================
     Medidas en unidades del mock (--hu, global.css): todo escala junto con el alto
     de la ventana, así navbar + cielo + niveles + pilares + franja siempre caben. */
  @media (min-width: 1200px) {
    .bank { left: 0; width: 100%; height: calc(150 * var(--hu)); transform: none; }

    .hero__content--sky {
      grid-template-columns: minmax(0, 1fr) calc(590 * var(--hu)) minmax(0, 1fr);
      width: calc(1536 * var(--hu));
      max-width: 100%;
      padding-block: calc(4 * var(--hu)) calc(30 * var(--hu));
    }
    .hero__lead { font-size: 2.95cqw; }

    .hero__art { margin-bottom: calc(-22 * var(--hu)); }
    .hero__mascot { width: calc(410 * var(--hu)); margin-left: calc(10 * var(--hu)); }
    .hero__kids { width: calc(540 * var(--hu)); margin-right: calc(-10 * var(--hu)); }

    .hero__actions { gap: calc(16 * var(--hu)) calc(26 * var(--hu)); margin-top: calc(-18 * var(--hu)); }
    .hero-btn {
      gap: calc(9 * var(--hu));
      min-height: calc(50 * var(--hu));
      padding: calc(5 * var(--hu)) calc(28 * var(--hu));
      font-size: calc(19.5 * var(--hu));
    }
    .hero-btn :global(svg) { width: calc(22 * var(--hu)); height: calc(22 * var(--hu)); }
    .hero-btn--video { padding-left: calc(6 * var(--hu)); }
    .hero-btn__play { width: calc(38 * var(--hu)); height: calc(38 * var(--hu)); }
    .hero-btn__play :global(svg) { width: calc(17 * var(--hu)); height: calc(17 * var(--hu)); }

    .hero__content--ground {
      width: calc(1412 * var(--hu));
      max-width: 100%;
      margin-top: calc(-28 * var(--hu));
    }
  }
</style>
