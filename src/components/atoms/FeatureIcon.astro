---
import type { FeatureIconName } from "./feature-icon.types";

interface Props {
  name: FeatureIconName;
  size?: number;
  /** Prefijo único para los ids de los degradados (evita choques si el ícono se repite en la página). */
  idPrefix?: string;
}

const { name, size = 64, idPrefix = `feature-${name}` } = Astro.props;
const id = (k: string) => `${idPrefix}-${k}`;
const url = (k: string) => `url(#${id(k)})`;
---

<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id("yellow")} x1="0" y1="0" x2=".7" y2="1"><stop stop-color="#FFF58A" /><stop offset="1" stop-color="#FFB800" /></linearGradient>
    <linearGradient id={id("blue")} x1="0" y1="0" x2=".8" y2="1"><stop stop-color="#7FE0FF" /><stop offset="1" stop-color="#1A84E6" /></linearGradient>
    <linearGradient id={id("pink")} x1="0" y1="0" x2=".7" y2="1"><stop stop-color="#FFA3C2" /><stop offset="1" stop-color="#F23F7A" /></linearGradient>
    <linearGradient id={id("green")} x1="0" y1="0" x2=".7" y2="1"><stop stop-color="#A6EF6E" /><stop offset="1" stop-color="#2DA83F" /></linearGradient>
    <linearGradient id={id("wood")} x1="0" y1="0" x2=".7" y2="1"><stop stop-color="#FFD08A" /><stop offset="1" stop-color="#E58A2E" /></linearGradient>
    <linearGradient id={id("navy")} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#4E78E6" /><stop offset="1" stop-color="#1E3B9A" /></linearGradient>
    <linearGradient id={id("purple")} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#C9A4FF" /><stop offset="1" stop-color="#7C4BE0" /></linearGradient>
    <radialGradient id={id("ocean")} cx=".35" cy=".3" r=".8"><stop stop-color="#7FDBFF" /><stop offset=".6" stop-color="#1C8CE8" /><stop offset="1" stop-color="#0F5BB8" /></radialGradient>
    <filter id={id("shadow")} x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="2" stdDeviation="1.4" flood-color="#263D83" flood-opacity=".25" /></filter>
  </defs>

  {name === "bulb" && (
    <g filter={url("shadow")} stroke-linecap="round" stroke-linejoin="round">
      <path d="M32 2v5M13 9l3.5 3.5M51 9l-3.5 3.5M5 26h5M54 26h5M9 42l4-2.5M55 42l-4-2.5" stroke="#FFC21A" stroke-width="3" />
      <path d="M32 10c-9.4 0-16 7-16 15.8 0 6 3.1 9.7 6 12.8 1.7 1.9 2.4 3.8 2.4 5.7V46h15.2v-1.7c0-1.9.7-3.8 2.4-5.7 2.9-3.1 6-6.8 6-12.8C48 17 41.4 10 32 10Z" fill={url("yellow")} stroke="#E79B00" stroke-width="1.6" />
      <path d="m27 35 2.6-4 2.4 4 2.4-4 2.6 4" stroke="#F07A00" stroke-width="1.8" />
      <path d="M22.5 22c1-4.5 4.5-7.4 8.5-8" stroke="#fff" stroke-opacity=".85" stroke-width="2.6" />
      <rect x="24" y="46" width="16" height="5" rx="2.5" fill={url("purple")} />
      <rect x="25.5" y="50.5" width="13" height="5" rx="2.5" fill={url("pink")} />
      <path d="M29 55.5h6l-1 3.5h-4Z" fill="#7C4BE0" />
    </g>
  )}

  {name === "puzzle" && (
    <g filter={url("shadow")} stroke-linejoin="round" stroke-width="1.6">
      <path d="M4 27a3 3 0 0 1 3-3h6a5 5 0 1 1 9 0h6a3 3 0 0 1 3 3v6a5 5 0 1 1 0 9v6a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3Z" fill={url("yellow")} stroke="#E79B00" transform="rotate(-8 18 38)" />
      <path d="M36 21h6a5 5 0 1 1 9 0h6a3 3 0 0 1 3 3v24a3 3 0 0 1-3 3H36a3 3 0 0 1-3-3v-6.5a5 5 0 1 0 0-9V24a3 3 0 0 1 3-3Z" fill={url("blue")} stroke="#1576CF" transform="rotate(6 46 36)" />
      <path d="M9 30h7M39 26h6" stroke="#fff" stroke-opacity=".8" stroke-width="2.4" stroke-linecap="round" />
    </g>
  )}

  {name === "palette" && (
    <g filter={url("shadow")} stroke-linecap="round" stroke-linejoin="round">
      <path d="M29 12C15.5 12 5 20.6 5 32.4 5 43 13.6 51 24.6 51c3.8 0 5-2 4-4.4-1-2.4.2-4.4 3-4.4h6.2C46 42.2 53 37.4 53 29 53 19.2 43 12 29 12Z" fill={url("wood")} stroke="#C96E1A" stroke-width="1.6" />
      <circle cx="19" cy="40" r="3.6" fill="#FFF6E8" stroke="#C96E1A" stroke-width="1.2" />
      <circle cx="17" cy="27" r="4.4" fill="#F4364C" />
      <circle cx="27" cy="20" r="4.4" fill="#FFD21F" />
      <circle cx="38.5" cy="21" r="4.4" fill="#36C24C" />
      <circle cx="45" cy="31" r="4.2" fill="#2E8BEF" />
      <path d="M12 23.5c1.2-1.6 3-2.4 4.6-2.4M24 16.8c1.2-1.2 2.6-1.8 4-1.8" stroke="#fff" stroke-opacity=".8" stroke-width="1.6" />
      <g transform="rotate(38 46 26)">
        <rect x="43.5" y="-4" width="5" height="24" rx="2.5" fill={url("navy")} />
        <rect x="43" y="19" width="6" height="5" rx="1" fill="#C7D1E6" />
        <path d="M43 24h6c0 5-1.5 9-3 11-1.5-2-3-6-3-11Z" fill="#2B2F5E" />
      </g>
    </g>
  )}

  {name === "book" && (
    <g filter={url("shadow")} stroke-linejoin="round" stroke-linecap="round">
      <path d="M4 18v32c10-2.4 20-1.6 28 3.4 8-5 18-5.8 28-3.4V18" fill={url("navy")} stroke="#173276" stroke-width="1.6" />
      <path d="M32 19C26 13.5 16.5 11.6 8 13.6v32.6c8.5-1.8 18 0 24 4.8Z" fill="#FFFDF5" stroke="#173276" stroke-width="1.6" />
      <path d="M32 19c6-5.5 15.5-7.4 24-5.4v32.6c-8.5-1.8-18 0-24 4.8Z" fill="#FFF6DD" stroke="#173276" stroke-width="1.6" />
      <path d="M13 21c5-.8 10 0 14 2.4M13 27c5-.8 10 0 14 2.4M13 33c5-.8 10 0 14 2.4M37 23.4c4-2.4 9-3.2 14-2.4M37 29.4c4-2.4 9-3.2 14-2.4M37 35.4c4-2.4 9-3.2 14-2.4" stroke="#9DB0D8" stroke-width="1.6" />
      <path d="M44 6l1.4 3 3.2.4-2.4 2.2.7 3.2-2.9-1.6-2.9 1.6.7-3.2-2.4-2.2 3.2-.4Z" fill="#FFD21F" />
    </g>
  )}

  {name === "heart" && (
    <g filter={url("shadow")}>
      <path d="M32 55S7 41 7 23.5C7 15.9 12.9 10 20.3 10c5 0 9 2.8 11.7 6.8C34.7 12.8 38.7 10 43.7 10 51.1 10 57 15.9 57 23.5 57 41 32 55 32 55Z" fill={url("pink")} />
      <ellipse cx="19" cy="21" rx="5" ry="3.4" fill="#fff" fill-opacity=".75" transform="rotate(-30 19 21)" />
    </g>
  )}

  {name === "family" && (
    <g filter={url("shadow")}>
      <circle cx="14" cy="22" r="7" fill={url("blue")} />
      <circle cx="50" cy="22" r="7" fill={url("blue")} />
      <path d="M2 50c0-9 5-15 12-15s12 6 12 15Z" fill={url("blue")} />
      <path d="M38 50c0-9 5-15 12-15s12 6 12 15Z" fill={url("blue")} />
      <circle cx="32" cy="19" r="9" fill={url("blue")} stroke="#1D3A86" stroke-width="1.4" />
      <path d="M16 54c0-11 7-18 16-18s16 7 16 18Z" fill={url("blue")} stroke="#1D3A86" stroke-width="1.4" />
      <path d="M27 14c1.4-2 3.4-3 5.6-3" stroke="#fff" stroke-opacity=".8" stroke-width="2" stroke-linecap="round" />
    </g>
  )}

  {name === "leaf" && (
    <g filter={url("shadow")} stroke-linecap="round" stroke-linejoin="round">
      <path d="M32 58V30" stroke="#2DA83F" stroke-width="3.4" />
      <path d="M32 36C30 22 19 15 6 17c1 13 12 21 26 19Z" fill={url("green")} />
      <path d="M32 30c2-13 13-21 26-19-1 14-12 21-26 19Z" fill={url("green")} />
      <path d="M11 20c6 1.4 11 5 15 10M53 14c-6 2-11 6-15 11" stroke="#fff" stroke-opacity=".6" stroke-width="1.8" />
    </g>
  )}

  {name === "globe" && (
    <g filter={url("shadow")}>
      <circle cx="32" cy="32" r="27" fill={url("ocean")} />
      <path d="M14 18c4-2 9-1 11 2s-1 6 2 8 7-1 8 3-4 6-8 6-5 5-9 4-6-6-6-10 0-9 2-13Z" fill="#4FC44F" />
      <path d="M38 12c5 0 10 3 13 7-3 1-6 0-8 2s1 5-1 7-6 0-7-3 0-6 1-8-1-4 2-5Z" fill="#4FC44F" />
      <path d="M40 40c3-1 7 0 9 3s-1 7-4 9-6 1-7-2 0-8 2-10Z" fill="#4FC44F" />
      <ellipse cx="22" cy="16" rx="7" ry="3.5" fill="#fff" fill-opacity=".45" transform="rotate(-28 22 16)" />
    </g>
  )}
</svg>
