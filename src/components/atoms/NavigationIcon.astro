---
import type { NavigationIconName } from "./navigation-icon.types";

interface Props {
  name: NavigationIconName;
  size?: number;
  idPrefix?: string;
}

const { name, size = 40, idPrefix = `navigation-${name}` } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${idPrefix}-yellow`} x1="0" y1="0" x2=".8" y2="1"><stop stop-color="#FFF58B" /><stop offset="1" stop-color="#FFB900" /></linearGradient>
    <linearGradient id={`${idPrefix}-pink`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FF80C7" /><stop offset="1" stop-color="#F22C8B" /></linearGradient>
    <linearGradient id={`${idPrefix}-blue`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#73E7FF" /><stop offset="1" stop-color="#168EEA" /></linearGradient>
    <linearGradient id={`${idPrefix}-purple`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#D89AFF" /><stop offset="1" stop-color="#8748E9" /></linearGradient>
    <linearGradient id={`${idPrefix}-orange`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FFE477" /><stop offset="1" stop-color="#FF8B25" /></linearGradient>
    <filter id={`${idPrefix}-shadow`} x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="2" stdDeviation="1.3" flood-color="#263D83" flood-opacity=".22" /></filter>
  </defs>

  {name === "home" && (
    <g filter={`url(#${idPrefix}-shadow)`} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4">
      <path d="M15 28 32 12l17 16v22a3 3 0 0 1-3 3H18a3 3 0 0 1-3-3V28Z" fill={`url(#${idPrefix}-yellow)`} />
      <path d="m10 28 19.2-18a4.1 4.1 0 0 1 5.6 0L54 28l-5.2 5L32 18.4 15.2 33 10 28Z" fill={`url(#${idPrefix}-pink)`} />
      <path d="M27 53V36a5 5 0 0 1 10 0v17" fill="#FF82C5" />
      <path d="M20 30h6v6h-6zM38 30h6v6h-6z" fill="#91E9FF" />
      <path d="M40 16V9h7v14" fill="#FF9A32" />
      <circle cx="32" cy="27" r="2" fill="#FFF77D" stroke="none" />
    </g>
  )}

  {name === "people" && (
    <g filter={`url(#${idPrefix}-shadow)`} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
      <path d="M7 48c.5-8 5.5-13 13-13s12.5 5 13 13v4H7v-4Z" fill={`url(#${idPrefix}-blue)`} />
      <path d="M31 47c.5-9 6-14 13.5-14S58 38 58 47v5H31v-5Z" fill={`url(#${idPrefix}-purple)`} />
      <path d="M18 39c-1 4-1 6-1 9M44 39c1 4 1 6 1 9" stroke="#fff" stroke-opacity=".8" stroke-width="2.4" />
      <circle cx="20" cy="24" r="9" fill={`url(#${idPrefix}-pink)`} />
      <circle cx="44" cy="22" r="10" fill={`url(#${idPrefix}-orange)`} />
      <path d="M12 23c0-7 4-11 9-11 4 0 7 2 8 6-3-1-5-2-8-2-2 3-5 5-9 7Z" fill="#7C3A93" />
      <path d="M35 20c0-6 4-11 10-11 5 0 9 4 9 10-4-3-7-4-12-3l-7 4Z" fill="#6B3B9A" />
      <circle cx="17" cy="25" r="1" fill="#173276" stroke="none" /><circle cx="23" cy="25" r="1" fill="#173276" stroke="none" />
      <circle cx="41" cy="23" r="1" fill="#173276" stroke="none" /><circle cx="47" cy="23" r="1" fill="#173276" stroke="none" />
      <path d="M18 29c1 2 3 2 4 0M42 28c1 2 3 2 4 0" />
    </g>
  )}

  {name === "levels" && (
    <g filter={`url(#${idPrefix}-shadow)`} stroke="#173276" stroke-linejoin="round" stroke-width="2.2">
      <rect x="21" y="6" width="25" height="25" rx="5" fill={`url(#${idPrefix}-purple)`} />
      <rect x="5" y="31" width="26" height="25" rx="5" fill={`url(#${idPrefix}-yellow)`} />
      <rect x="33" y="31" width="26" height="25" rx="5" fill={`url(#${idPrefix}-blue)`} />
      <path d="M26 6V3h15v3" stroke="#FFDA45" stroke-width="3" />
      <text x="33.5" y="25" fill="#fff" stroke="none" font-family="Nunito, sans-serif" font-size="17" font-weight="900" text-anchor="middle">A</text>
      <text x="18" y="50" fill="#173276" stroke="none" font-family="Nunito, sans-serif" font-size="17" font-weight="900" text-anchor="middle">B</text>
      <text x="46" y="50" fill="#173276" stroke="none" font-family="Nunito, sans-serif" font-size="17" font-weight="900" text-anchor="middle">C</text>
      <path d="M26 11h15" stroke="#F4D8FF" stroke-width="2" />
    </g>
  )}

  {name === "methodology" && (
    <g filter={`url(#${idPrefix}-shadow)`} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2">
      <path d="M8 15c8-3 16-1 24 5v35c-8-6-16-8-24-5V15Z" fill="#FFFDF2" />
      <path d="M56 15c-8-3-16-1-24 5v35c8-6 16-8 24-5V15Z" fill="#FFFDF2" />
      <path d="M32 20v35" stroke="#E84F88" stroke-width="3" />
      <path d="M13 23c5-1 9 0 14 3M13 30c5-1 9 0 14 3M13 37c5-1 9 0 14 3M51 23c-5-1-9 0-14 3M51 30c-5-1-9 0-14 3M51 37c-5-1-9 0-14 3" stroke="#539EDB" stroke-width="1.8" />
      <path d="M8 15c8-3 16-1 24 5 8-6 16-8 24-5v35c-8-3-16-1-24 5-8-6-16-8-24-5V15Z" fill={`url(#${idPrefix}-blue)`} fill-opacity=".14" />
    </g>
  )}

  {name === "experiences" && (
    <g filter={`url(#${idPrefix}-shadow)`} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2">
      <path d="M18 18h8l4-5h11l4 5h5a5 5 0 0 1 5 5v25a5 5 0 0 1-5 5H14a5 5 0 0 1-5-5V23a5 5 0 0 1 5-5h4Z" fill={`url(#${idPrefix}-purple)`} />
      <path d="M14 18h36a5 5 0 0 1 5 5v5H9v-5a5 5 0 0 1 5-5Z" fill={`url(#${idPrefix}-pink)`} />
      <circle cx="32" cy="36" r="12" fill="#EEF9FF" /><circle cx="32" cy="36" r="8" fill={`url(#${idPrefix}-blue)`} />
      <circle cx="29" cy="33" r="2.4" fill="#fff" stroke="none" /><circle cx="47" cy="23" r="2" fill="#FFE85B" stroke="none" />
      <path d="M18 12h7" stroke="#fff" stroke-width="3" />
    </g>
  )}

  {name === "events" && (
    <g filter={`url(#${idPrefix}-shadow)`} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2">
      <rect x="9" y="14" width="42" height="40" rx="7" fill="#FFFDF6" />
      <path d="M9 21a7 7 0 0 1 7-7h28a7 7 0 0 1 7 7v6H9v-6Z" fill={`url(#${idPrefix}-pink)`} />
      <path d="M19 9v10M41 9v10" stroke="#EF437B" stroke-width="4" />
      <path d="M18 34h3M28 34h3M38 34h3M18 43h3M28 43h3" stroke="#2789D7" stroke-width="4" />
      <path d="m47 32 2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8 2.5-5Z" fill={`url(#${idPrefix}-yellow)`} />
    </g>
  )}

  {name === "contact" && (
    <g filter={`url(#${idPrefix}-shadow)`} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2">
      <rect x="7" y="15" width="50" height="37" rx="7" fill={`url(#${idPrefix}-orange)`} />
      <path d="M9 20 32 38l23-18" fill="#FFF5AE" />
      <path d="m9 49 17-15M55 49 38 34" stroke="#F07828" stroke-width="3" />
      <path d="m17 15 7-7h16l7 7" fill={`url(#${idPrefix}-blue)`} />
      <path d="m9 20 23 18 23-18" fill="none" stroke="#C7661D" stroke-width="2.6" />
    </g>
  )}
</svg>
