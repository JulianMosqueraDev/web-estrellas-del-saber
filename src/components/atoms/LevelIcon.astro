---
import type { LevelIconName } from "./level-icon.types";

interface Props {
  name: LevelIconName;
  size?: number;
  /** Prefijo único para los ids de los degradados (evita choques si el ícono se repite en la página). */
  idPrefix?: string;
}

const { name, size = 56, idPrefix = `level-${name}` } = Astro.props;
const id = (k: string) => `${idPrefix}-${k}`;
const url = (k: string) => `url(#${id(k)})`;
---

<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id("brown")} x1="0" y1="0" x2=".6" y2="1"><stop stop-color="#F6BE84" /><stop offset="1" stop-color="#C9783C" /></linearGradient>
    <linearGradient id={id("yellow")} x1="0" y1="0" x2=".8" y2="1"><stop stop-color="#FFF27A" /><stop offset="1" stop-color="#FFB300" /></linearGradient>
    <linearGradient id={id("orange")} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FFD25A" /><stop offset="1" stop-color="#FF8A1F" /></linearGradient>
    <linearGradient id={id("red")} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FF8A8A" /><stop offset="1" stop-color="#E8354B" /></linearGradient>
    <linearGradient id={id("blue")} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#73E0FF" /><stop offset="1" stop-color="#1A8EEA" /></linearGradient>
    <linearGradient id={id("green")} x1="0" y1="0" x2=".7" y2="1"><stop stop-color="#9BE86A" /><stop offset="1" stop-color="#2FA63C" /></linearGradient>
    <linearGradient id={id("pink")} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FF9ACD" /><stop offset="1" stop-color="#F0468F" /></linearGradient>
    <filter id={id("shadow")} x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="2" stdDeviation="1.3" flood-color="#263D83" flood-opacity=".22" /></filter>
  </defs>

  {name === "bear" && (
    <g filter={url("shadow")} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
      <circle cx="18" cy="12" r="6.5" fill={url("brown")} />
      <circle cx="46" cy="12" r="6.5" fill={url("brown")} />
      <circle cx="18" cy="12" r="3" fill="#FFD9B5" stroke="none" />
      <circle cx="46" cy="12" r="3" fill="#FFD9B5" stroke="none" />
      <ellipse cx="13" cy="42" rx="5" ry="7" fill={url("brown")} transform="rotate(-25 13 42)" />
      <ellipse cx="51" cy="42" rx="5" ry="7" fill={url("brown")} transform="rotate(25 51 42)" />
      <ellipse cx="32" cy="46" rx="15" ry="13" fill={url("brown")} />
      <ellipse cx="32" cy="48" rx="8.5" ry="7.5" fill="#FFE1C2" stroke="none" />
      <ellipse cx="22" cy="58" rx="6" ry="4" fill={url("brown")} />
      <ellipse cx="42" cy="58" rx="6" ry="4" fill={url("brown")} />
      <circle cx="32" cy="22" r="14" fill={url("brown")} />
      <ellipse cx="32" cy="27" rx="6.5" ry="5" fill="#FFE1C2" />
      <ellipse cx="32" cy="24.6" rx="2.4" ry="1.7" fill="#173276" stroke="none" />
      <path d="M29.6 28.4c1.4 1.4 3.4 1.4 4.8 0" stroke-width="1.6" />
      <circle cx="26.5" cy="19.5" r="1.6" fill="#173276" stroke="none" />
      <circle cx="37.5" cy="19.5" r="1.6" fill="#173276" stroke="none" />
      <circle cx="23" cy="25" r="2" fill="#FF8FB8" fill-opacity=".7" stroke="none" />
      <circle cx="41" cy="25" r="2" fill="#FF8FB8" fill-opacity=".7" stroke="none" />
    </g>
  )}

  {name === "blocks" && (
    <g filter={url("shadow")} stroke="#173276" stroke-linejoin="round" stroke-width="2">
      <rect x="6" y="34" width="24" height="24" rx="4.5" fill={url("red")} />
      <rect x="34" y="34" width="24" height="24" rx="4.5" fill={url("yellow")} />
      <rect x="20" y="8" width="24" height="24" rx="4.5" fill={url("blue")} transform="rotate(-6 32 20)" />
      <path d="M10 39h9M38 39h9" stroke="#fff" stroke-opacity=".75" stroke-width="2.6" stroke-linecap="round" />
      <circle cx="18" cy="48" r="4" fill="#fff" fill-opacity=".9" stroke="none" />
      <path d="m46 40 2.4 4.8 5.3.8-3.9 3.7.9 5.2-4.7-2.5-4.7 2.5.9-5.2-3.9-3.7 5.3-.8Z" fill="#fff" fill-opacity=".9" stroke="none" />
      <path d="M27 24l5-7 5 7Z" fill="#fff" fill-opacity=".9" stroke="none" transform="rotate(-6 32 20)" />
    </g>
  )}

  {name === "sun" && (
    <g filter={url("shadow")} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
      <g fill={url("orange")} stroke="#E07A10" stroke-width="1.4">
        {Array.from({ length: 8 }, (_, i) => (
          <path d="M32 2.5 36 11h-8Z" transform={`rotate(${i * 45} 32 32)`} />
        ))}
      </g>
      <circle cx="32" cy="32" r="16" fill={url("yellow")} />
      <path d="M26.5 29.5c.8-1.6 2.6-1.6 3.4 0M34.1 29.5c.8-1.6 2.6-1.6 3.4 0" stroke-width="1.8" />
      <path d="M26.5 35.5c2.8 4 8.2 4 11 0" fill="#FF6F61" stroke-width="1.8" />
      <circle cx="23.5" cy="34" r="2.4" fill="#FF8FB8" fill-opacity=".75" stroke="none" />
      <circle cx="40.5" cy="34" r="2.4" fill="#FF8FB8" fill-opacity=".75" stroke="none" />
      <path d="M22 26c1.5-4 4.5-6.5 8-7.5" stroke="#fff" stroke-opacity=".8" stroke-width="2.4" />
    </g>
  )}

  {name === "sprout" && (
    <g filter={url("shadow")} stroke="#173276" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
      <path d="M32 50V27" stroke-width="3" />
      <path d="M32 33C30 21 20 15 7 17c1 12 11 19 25 16Z" fill={url("green")} />
      <path d="M32 28c2-12 12-19 26-17-1 13-11 20-26 17Z" fill={url("green")} />
      <path d="M12 20c6 1 12 5 16 10M53 15c-6 2-12 6-16 10" stroke="#fff" stroke-opacity=".7" stroke-width="2" />
      <path d="M12 58c1-7 9-10 20-10s19 3 20 10Z" fill="#B97A4A" />
      <path d="M20 54c2-1.6 5-2.4 8-2.6" stroke="#E7B88A" stroke-width="2" />
    </g>
  )}

  {name === "pencil" && (
    <g filter={url("shadow")} stroke="#173276" stroke-linejoin="round" stroke-width="2" transform="rotate(40 32 32)">
      <path d="M25 6a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v5H25Z" fill={url("pink")} />
      <path d="M25 11h14v5H25Z" fill="#C8D3E8" />
      <path d="M25 16h14v28H25Z" fill={url("orange")} />
      <path d="M29.6 16v28M34.4 16v28" stroke="#E07A10" stroke-width="1.4" />
      <path d="M25 44h14l-7 15Z" fill="#FFD9A8" />
      <path d="m29.2 53 2.8 6 2.8-6Z" fill="#173276" />
    </g>
  )}
</svg>
