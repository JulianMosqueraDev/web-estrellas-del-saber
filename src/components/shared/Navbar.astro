---
import { Image } from "astro:assets";
import BrandLogo from "../atoms/BrandLogo.astro";
import Icon from "../atoms/Icon.astro";
import NavigationIcon from "../atoms/NavigationIcon.astro";
import type { NavigationIconName } from "../atoms/navigation-icon.types";

import arcoiris from "./icons/arcoiris.png";
import cohete from "./icons/cohete.png";
import dinosaurio from "./icons/dinosaurio.png";
import estrella from "./icons/estrella.png";
import estrellaAmarilla from "./icons/estrella-amarilla.png";
import nina from "./icons/niña.png";
import nino from "./icons/nño.png";
import pasto1 from "./icons/pasto1.png";
import pasto2 from "./icons/pasto2.png";
import planeta from "./icons/planeta.png";

/* =====================================================================
   La escena desktop/tablet usa un lienzo de 1440 × 256 unidades.
   1 unidad = 100cqw / 1440, así toda la ilustración escala junta.
   Las coordenadas salen de mocks/navbar/navbar.png.
   ===================================================================== */

interface NavItem {
  href: string;
  label: string;
  icon: NavigationIconName;
}

const links: NavItem[] = [
  { href: "/", label: "Inicio", icon: "home" },
  { href: "/nosotros", label: "Nosotros", icon: "people" },
  { href: "/niveles", label: "Niveles", icon: "levels" },
  { href: "/metodologia", label: "Metodología", icon: "methodology" },
  { href: "/experiencias", label: "Experiencias", icon: "experiences" },
  { href: "/eventos", label: "Eventos", icon: "events" },
  { href: "/contacto", label: "Contacto", icon: "contact" },
];

// Botones-estrella: todos del mismo tamaño, repartidos entre el logo y el CTA
const STAR_X = 312;
const STAR_STEP = 120;
const STAR_SIZE = 124;

/** Estrella de 5 puntas con puntas y esquinas redondeadas (viewBox 100 × 100). */
function roundedStar(cx: number, cy: number, R: number, r: number, tipCut: number, innerCut: number) {
  const pts = Array.from({ length: 10 }, (_, i) => {
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    const rad = i % 2 ? r : R;
    return [cx + rad * Math.cos(a), cy + rad * Math.sin(a)];
  });
  const f = (n: number) => n.toFixed(1);
  let d = "";
  pts.forEach(([vx, vy], i) => {
    const [px, py] = pts[(i + 9) % 10];
    const [nx, ny] = pts[(i + 1) % 10];
    const t = i % 2 ? innerCut : tipCut;
    d += `${i ? "L" : "M"}${f(vx + (px - vx) * t)} ${f(vy + (py - vy) * t)}`;
    d += `Q${f(vx)} ${f(vy)} ${f(vx + (nx - vx) * t)} ${f(vy + (ny - vy) * t)}`;
  });
  return `${d}Z`;
}
const starPath = roundedStar(50, 54, 44, 28, 0.34, 0.2);

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);

// Ventana visible del lienzo (recorta el aire de arriba y abajo para un navbar más bajo)
const VIEW_TOP = 22;
const VIEW_H = 228;
const viewBox = `0 ${VIEW_TOP} 1440 ${VIEW_H}`;

const pos = (x: number, y: number, w: number, h?: number) =>
  `--x:${x};--y:${y};--w:${w}${h !== undefined ? `;--h:${h}` : ""}`;

/** Contorno ondulado: cada tramo [xFin, yFin, altura] es una curva Bézier. */
type Bump = [number, number, number];
function bumps(x0: number, y0: number, list: Bump[]) {
  let d = "";
  for (const [x1, y1, h] of list) {
    const dx = x1 - x0;
    d += ` C${(x0 + dx * 0.06).toFixed(1)} ${y0 - h} ${(x1 - dx * 0.06).toFixed(1)} ${y1 - h} ${x1} ${y1}`;
    x0 = x1;
    y0 = y1;
  }
  return d;
}

/** Bumps pseudoaleatorios (semilla fija) para el césped: alturas y anchos variados. */
function grassBumps(seed: number, from: number, to: number, base: number, hMin: number, hMax: number) {
  let s = seed;
  const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  const out: Bump[] = [];
  let x = from;
  while (x < to - 20) {
    x = Math.min(to - 10, x + 34 + rnd() * 62);
    out.push([Math.round(x), Math.round(base + (rnd() - 0.5) * 8), Math.round(hMin + rnd() * (hMax - hMin))]);
  }
  return out;
}

// Cielo: borde superior con lomas orgánicas de distintos tamaños
const skyPath =
  "M374 222 L374 160 C368 132 386 118 412 118" +
  bumps(412, 118, [
    [468, 110, 30], [552, 104, 52], [612, 114, 26], [706, 98, 58], [792, 108, 46],
    [846, 114, 24], [944, 96, 56], [1022, 108, 42], [1086, 102, 34], [1148, 112, 30], [1190, 122, 20],
  ]) +
  " C1216 124 1224 150 1220 170 L1220 222 Z";

const skyHills =
  "M380 222 L380 168" +
  bumps(380, 168, [
    [446, 158, 22], [520, 164, 28], [600, 154, 26], [690, 162, 32], [770, 152, 24],
    [860, 160, 30], [950, 150, 26], [1040, 160, 30], [1120, 152, 24], [1214, 166, 22],
  ]) +
  " L1214 222 Z";

// Nubes del fondo (tono azulado) — capa media
const backClouds =
  "M296 240 L296 186" +
  bumps(296, 186, [
    [350, 160, 40], [418, 154, 36], [470, 162, 24], [544, 150, 44], [602, 160, 28],
    [672, 152, 40], [732, 160, 26], [804, 150, 42], [862, 160, 28], [934, 152, 40],
    [992, 160, 26], [1062, 150, 42], [1120, 160, 30], [1172, 158, 22], [1248, 160, 20],
    [1320, 156, 22], [1392, 158, 34], [1438, 198, 28],
  ]) +
  " L1438 240 Z";

// Nubes blancas delanteras — soporte de los botones
const frontClouds =
  "M290 244 L290 198" +
  bumps(290, 198, [
    [342, 174, 30], [402, 180, 22], [454, 172, 30], [522, 178, 24], [578, 170, 32],
    [642, 178, 22], [702, 172, 30], [772, 180, 24], [832, 170, 32], [902, 178, 22],
    [962, 172, 30], [1032, 180, 24], [1092, 170, 30], [1150, 174, 26], [1222, 166, 30],
    [1290, 172, 26], [1362, 164, 30], [1418, 176, 26], [1440, 208, 16],
  ]) +
  " L1440 244 Z";

// Nube institucional del logo: horizontal, lomas de distintas alturas
const logoCloud =
  "M34 246 C8 246 -2 226 8 208 C-6 190 -2 152 20 146" +
  bumps(20, 146, [
    [60, 114, 30], [106, 112, 34], [152, 112, 20], [200, 114, 16],
    [248, 112, 16], [292, 114, 14], [330, 132, 16],
  ]) +
  " C352 134 362 160 350 182 C362 204 352 246 322 246 Z";

// Césped: dos capas de lomas con distintas alturas
const grassBack =
  "M40 246 C16 246 6 232 14 214" + bumps(14, 214, grassBumps(7, 14, 1428, 212, 12, 26)) + " C1438 232 1426 246 1400 246 Z";
const grassFront =
  "M40 248 C18 248 6 238 10 226" + bumps(10, 226, grassBumps(31, 10, 1432, 226, 6, 16)) + " C1436 238 1424 248 1400 248 Z";

// Elementos de la escena: [x, y, ancho]
const skyStars: [number, number, number][] = [
  [470, 96, 24], [544, 92, 28], [630, 98, 22], [946, 92, 28], [1014, 104, 22],
];
const sparkles: [number, number, number][] = [
  [500, 132, 7], [588, 124, 6], [760, 128, 8], [880, 96, 6], [998, 132, 7], [1110, 92, 8], [1160, 136, 6],
];

// Franja de nubes para la versión móvil (viewBox 400 × 40)
const mobileCloudStrip =
  "M0 40 L0 24" +
  bumps(0, 24, [
    [26, 22, 14], [58, 26, 10], [88, 20, 16], [120, 25, 11], [150, 21, 14], [186, 26, 9],
    [214, 20, 15], [248, 24, 12], [280, 21, 14], [312, 26, 10], [344, 20, 15], [374, 25, 11], [400, 22, 13],
  ]) +
  " L400 40 Z";
---

<header class="site-header">
  <div class="nav-shell">
    <!-- ================= Desktop / tablet: ilustración ================= -->
    <div class="stage" style={`--oy:${VIEW_TOP};aspect-ratio:1440 / ${VIEW_H}`}>
      <!-- Capa 1 · Cielo -->
      <svg class="layer layer--sky" viewBox={viewBox} aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="nb-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#36a9ee" />
            <stop offset=".55" stop-color="#7fd0fb" />
            <stop offset="1" stop-color="#c6ebff" />
          </linearGradient>
          <linearGradient id="nb-cloud" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset=".55" stop-color="#ffffff" />
            <stop offset="1" stop-color="#e3f0fc" />
          </linearGradient>
          <linearGradient id="nb-cloud-back" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f4f9ff" />
            <stop offset="1" stop-color="#d6e9fa" />
          </linearGradient>
          <linearGradient id="nb-grass" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#a6e85a" />
            <stop offset=".5" stop-color="#6fcf37" />
            <stop offset="1" stop-color="#47ad26" />
          </linearGradient>
          <linearGradient id="nb-grass-back" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#7fd645" />
            <stop offset="1" stop-color="#3f9f22" />
          </linearGradient>
        </defs>
        <path d={skyPath} fill="url(#nb-sky)" stroke="#ffffff" stroke-opacity=".7" stroke-width="3" />
        <path d={skyHills} fill="#a9e2ff" fill-opacity=".55" />
        <path
          d="M420 150C462 118 512 132 550 114S632 98 682 114M792 106C830 96 852 120 884 110M962 112C1000 96 1040 128 1082 112S1150 104 1188 122"
          fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="8 9" stroke-linecap="round"
        />
        {sparkles.map(([x, y, s]) => (
          <path d={`M${x} ${y - s}L${x + s * 0.28} ${y - s * 0.28} ${x + s} ${y} ${x + s * 0.28} ${y + s * 0.28} ${x} ${y + s} ${x - s * 0.28} ${y + s * 0.28} ${x - s} ${y} ${x - s * 0.28} ${y - s * 0.28}Z`} fill="#fff" />
        ))}
      </svg>

      <!-- Capa 2 · Personajes y decoración (detrás de las nubes) -->
      <div class="layer layer--deco" aria-hidden="true">
        <Image src={arcoiris} alt="" width={340} format="webp" quality={76} loading="eager" class="abs" style={pos(48, 50, 162)} />
        <Image src={pasto2} alt="" width={240} format="webp" quality={74} class="abs" style={pos(1328, 74, 112)} />
        <Image src={nino} alt="" width={320} format="webp" quality={80} loading="eager" class="abs" style={pos(180, 20, 152)} />
        <Image src={dinosaurio} alt="" width={260} format="webp" quality={78} loading="eager" class="abs" style={pos(318, 52, 122)} />
        <Image src={estrella} alt="" width={240} format="webp" quality={80} loading="eager" class="abs float" style={pos(656, 26, 104)} />
        <Image src={cohete} alt="" width={260} format="webp" quality={78} loading="eager" class="abs float float--b" style={pos(818, 24, 118)} />
        <Image src={planeta} alt="" width={240} format="webp" quality={78} loading="eager" class="abs float float--c" style={pos(1034, 28, 110)} />
        <Image src={nina} alt="" width={360} format="webp" quality={80} loading="eager" class="abs" style={pos(1166, 18, 164)} />
        {skyStars.map(([x, y, w]) => (
          <Image src={estrellaAmarilla} alt="" width={64} format="webp" quality={72} class="abs" style={pos(x, y, w)} />
        ))}
      </div>

      <!-- Capa 3 · Nubes y césped -->
      <svg class="layer layer--front" viewBox={viewBox} aria-hidden="true" focusable="false">
        <path d={backClouds} fill="url(#nb-cloud-back)" stroke="#cfe3f6" stroke-width="2" />
        <path d={frontClouds} fill="url(#nb-cloud)" stroke="#d2e5f7" stroke-width="2" />
        <defs>
          <linearGradient id="nb-logo-cloud" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset=".62" stop-color="#ffffff" />
            <stop offset="1" stop-color="#e6f2fd" />
          </linearGradient>
          <linearGradient id="nb-star-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset=".6" stop-color="#ffffff" />
            <stop offset="1" stop-color="#fff5d9" />
          </linearGradient>
          <linearGradient id="nb-star-gold" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffdd55" />
            <stop offset="1" stop-color="#f4b000" />
          </linearGradient>
          <filter id="nb-logo-glow" x="-15%" y="-25%" width="130%" height="150%">
            <feDropShadow dx="0" dy="3" stdDeviation="7" flood-color="#3d9fe6" flood-opacity=".32" />
          </filter>
        </defs>
        <path d={logoCloud} fill="url(#nb-logo-cloud)" stroke="#a9d7f6" stroke-width="3" filter="url(#nb-logo-glow)" />
        <path d="M30 150C40 134 52 126 66 124M110 104C124 98 140 98 152 104" fill="none" stroke="#dff0fd" stroke-width="3" stroke-linecap="round" />
        <path d={grassBack} fill="url(#nb-grass-back)" />
        <path d={grassFront} fill="url(#nb-grass)" stroke="#3f9f22" stroke-width="1.6" />      </svg>

      <!-- Capa 4 · Arbustos -->
      <div class="layer layer--bushes" aria-hidden="true">
        <Image src={pasto1} alt="" width={200} format="webp" quality={74} class="abs" style={pos(-6, 180, 92)} />
        <Image src={pasto2} alt="" width={120} format="webp" quality={72} class="abs" style={pos(600, 214, 40)} />
        <Image src={pasto1} alt="" width={120} format="webp" quality={72} class="abs" style={pos(1148, 204, 54)} />
        <Image src={pasto2} alt="" width={120} format="webp" quality={72} class="abs" style={pos(1390, 202, 52)} />
      </div>

      <!-- Capa 5 · Contenido interactivo -->
      <div class="abs stage__brand" style={pos(10, 114, 300, 88)}>
        <BrandLogo cloud={false} tagline />
      </div>

      <nav class="stage__nav" aria-label="Principal">
        <ul>
          {links.map((link, i) => {
            const active = isActive(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  class:list={["abs", "star-link", { "is-active": active }]}
                  style={pos(STAR_X + i * STAR_STEP, 122, STAR_SIZE, 122)}
                  aria-current={active ? "page" : undefined}
                  title={link.label}
                >
                  <svg class="star-link__star" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
                    <path d={starPath} fill="#d98f00" stroke="#d98f00" stroke-width="10" stroke-linejoin="round" />
                    <path d={starPath} fill="url(#nb-star-gold)" stroke="url(#nb-star-gold)" stroke-width="6.5" stroke-linejoin="round" />
                    <path d={starPath} fill="url(#nb-star-fill)" />
                  </svg>
                  <NavigationIcon name={link.icon} size={48} idPrefix={`desk-${link.icon}`} />
                  <span class="star-link__label">{link.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <a class="abs pill-cta" href="/contacto#agenda" style={pos(1160, 154, 204, 56)}>
        <Icon name="calendar" size={22} />
        <span class="pill-cta__label">Agenda una visita</span>
      </a>
      <button class="abs search-btn" type="button" aria-label="Buscar" style={pos(1374, 155, 54, 54)}>
        <Icon name="search" size={24} />
      </button>
    </div>

    <!-- ================= Móvil ================= -->
    <div class="mbar">
      <div class="mbar__sky" aria-hidden="true">
        <svg class="mbar__clouds" viewBox="0 0 400 40" preserveAspectRatio="none">
          <path d={mobileCloudStrip} fill="#fff" />
        </svg>
      </div>
      <Image src={pasto1} alt="" width={100} format="webp" quality={72} class="mbar__tuft mbar__tuft--l" aria-hidden="true" />
      <Image src={pasto2} alt="" width={100} format="webp" quality={72} class="mbar__tuft mbar__tuft--r" aria-hidden="true" />
      <BrandLogo />
      <div class="mbar__actions">
        <a class="mbar__cta" href="/contacto#agenda">
          <Icon name="calendar" size={20} />
          <span class="mbar__cta-label">Agenda una visita</span>
        </a>
        <button class="mbar__search" type="button" aria-label="Buscar"><Icon name="search" size={22} /></button>
        <button class="mbar__menu" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
          <Icon name="menu" size={24} />
        </button>
      </div>
    </div>

    <div class="mmenu" id="mobile-menu" hidden>
      <!-- Cabecera limpia: logo completo (con lema) sobre fondo claro, sin nube ni decoración -->
      <div class="mmenu__head">
        <BrandLogo cloud={false} tagline />
        <button class="mmenu__close" type="button" aria-label="Cerrar menú" data-menu-close>
          <Icon name="close" size={24} />
        </button>
      </div>
      <nav aria-label="Principal móvil">
        <ul class="mmenu__list">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={["mmenu__link", { "is-active": isActive(link.href) }]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                <NavigationIcon name={link.icon} size={40} idPrefix={`mob-${link.icon}`} />
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="mmenu__cta" href="/contacto#agenda">
        <Icon name="calendar" size={22} />
        <span>Agenda una visita</span>
      </a>
      <Image src={pasto2} alt="" width={140} format="webp" quality={72} class="mmenu__grass mmenu__grass--l" aria-hidden="true" />
      <Image src={pasto1} alt="" width={140} format="webp" quality={72} class="mmenu__grass mmenu__grass--r" aria-hidden="true" />
    </div>
  </div>
</header>

<script>
  // Marca el navbar cuando la página ya se desplazó (muestra la franja de fondo).
  // Solo toca el DOM cuando el estado cambia (no en cada evento de scroll).
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    let stuck = false;
    const update = () => {
      const next = window.scrollY > 4;
      if (next !== stuck) {
        stuck = next;
        header.classList.toggle("is-stuck", stuck);
      }
    };
    window.addEventListener("scroll", update, { passive: true });
    update();
  }

  const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const menu = document.getElementById("mobile-menu");

  if (openBtn && closeBtn && menu) {
    const setOpen = (open: boolean, restoreFocus = true) => {
      menu.hidden = !open;
      openBtn.setAttribute("aria-expanded", String(open));
      if (open) closeBtn.focus();
      else if (restoreFocus) openBtn.focus();
    };

    openBtn.addEventListener("click", () => setOpen(true));
    closeBtn.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) setOpen(false);
    });
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches && !menu.hidden) setOpen(false, false);
    });
  }
</script>

<style>
  /* Fijo arriba al hacer scroll (sticky: arriba de todo ocupa su lugar normal,
     así el hero no se mueve) */
  .site-header {
    --navy: #13306f;
    position: sticky;
    top: 0;
    z-index: 50;
    padding: .3rem clamp(.75rem, 2vw, 1.5rem) 0;
    font-family: "Baloo 2", "Nunito", sans-serif;
    /* Capa propia en la GPU: al hacer scroll el navbar se mueve como una sola pieza
       (sin volver a pintar sus sombras y filtros en cada cuadro, que lo hacía temblar) */
    will-change: transform;
    backface-visibility: hidden;
  }
  /* Al bajar aparece una franja de cielo detrás del navbar, para que el contenido no
     se vea entre los personajes y las nubes. Opaca y sin desenfoque (backdrop-filter):
     el desenfoque obligaba a recalcular todo lo de atrás en cada cuadro del scroll. */
  .site-header::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background: linear-gradient(180deg, #5cbaf5 0%, #aadefd 100%);
    box-shadow: 0 8px 22px rgb(26 73 153 / 20%);
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease;
  }
  .site-header.is-stuck::before { opacity: 1; }

  .nav-shell {
    position: relative;
    /* En escritorio escala con el lienzo del hero (global.css → --nav-max) */
    max-width: var(--nav-max, 1480px);
    margin: 0 auto;
    container-type: inline-size;
  }

  /* ================= Escena (≥ 768px) ================= */
  .stage {
    --u: calc(100cqw / 1440);
    position: relative;
    width: 100%;
  }

  .layer { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .layer--sky { z-index: 0; }
  .layer--deco { z-index: 1; }
  .layer--front { z-index: 2; filter: drop-shadow(0 calc(6 * var(--u)) calc(8 * var(--u)) rgb(30 80 150 / 16%)); }
  .layer--bushes { z-index: 3; }

  .abs {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc((var(--y) - var(--oy, 0)) * var(--u));
    width: calc(var(--w) * var(--u));
  }
  img.abs { height: auto; object-fit: contain; }
  .layer--deco img { filter: drop-shadow(0 calc(4 * var(--u)) calc(5 * var(--u)) rgb(26 73 153 / 18%)); }

  .float { animation: float 4.5s ease-in-out infinite; }
  .float--b { animation-duration: 5.5s; animation-delay: -1.5s; }
  .float--c { animation-duration: 6.5s; animation-delay: -3s; }
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(calc(-6 * var(--u))) rotate(-3deg); }
  }

  /* Logo dentro de la nube grande */
  .stage__brand { z-index: 4; height: calc(var(--h) * var(--u)); display: flex; align-items: center; }
  .stage .stage__brand :global(.brand) {
    width: 100%;
    gap: calc(5 * var(--u));
    padding: 0;
  }
  .stage .stage__brand :global(.brand__mark) { width: calc(80 * var(--u)); }
  .stage .stage__brand :global(.brand__text) { gap: calc(3 * var(--u)); }
  @media (max-width: 1023px) {
